# Limites anti-abus / capacité (valeurs par défaut sûres si absentes)
MAX_DOWNLOAD_MB=100
MAX_EPISODE_DURATION_SECONDS=3600
MAX_CONCURRENT_JOBS=3
WORKSPACE_TTL_MINUTES=30
RATE_LIMIT_PER_MINUTE=10

# Optionnel — fallback PodcastIndex si iTunes Search ne suffit pas
# PODCASTINDEX_API_KEY=
# PODCASTINDEX_API_SECRET=

# Intro TTS (spec 07) — défaut : Edge (gratuit, sans clé)
# TTS_PROVIDER=edge
# TTS_LANGUAGE=fr-FR
# TTS_VOICE=fr-FR-EloiseNeural
# TTS_TIMEOUT_MS=8000
# TTS_MAX_CONCURRENT=1
# TTS_MAX_CHARS=200
# Alternatives avec compte :
# TTS_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# TTS_PROVIDER=google
# GOOGLE_TTS_API_KEY=
